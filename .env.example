# Copy to .env.local and fill in. Names only — never commit real values.
ANTHROPIC_API_KEY=            # sk-ant-… from console.anthropic.com
OPENROUTER_API_KEY=           # optional: Claude via OpenRouter instead
MODEL_PROVIDER=               # anthropic | openrouter | demo (blank = auto)
MODEL_NAME=claude-sonnet-5-5
MODEL_EFFORT=high            # high or medium

# Email: smtp | resend | simulated (blank = auto: SMTP → Resend → simulated)
EMAIL_PROVIDER=
# Gmail SMTP — SMTP_PASS is a 16-character App Password (myaccount.google.com/apppasswords), not your Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=                    # e.g. dripi.demo@gmail.com
SMTP_PASS=
SMTP_FROM=                    # optional, e.g. Dripi <dripi.demo@gmail.com> — must be the Gmail account or a verified alias

# Email (Resend). Leave empty to simulate sending.
RESEND_API_KEY=
RESEND_FROM=                 # e.g. Dripi <decisions@your-domain.com>
RESEND_WEBHOOK_SECRET=       # whsec_… from the Resend webhook settings

# Database: local SQLite file by default; a Turso URL + token in production.
DATABASE_URL=file:./data/dripi.db
DATABASE_AUTH_TOKEN=

# Random strings: openssl rand -hex 32
AUTH_SECRET=
CRON_SECRET=

# Public address for links in emails, e.g. https://dripi.vercel.app (blank = current host)
APP_URL=
